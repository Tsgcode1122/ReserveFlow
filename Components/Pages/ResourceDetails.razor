@page "/resources/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using ReserveFlow.Data
@using ReserveFlow.Data.Entities
@using ReserveFlow.Services.Reservations
@using ReserveFlow.Services.Availability

@inject IAvailabilityService AvailabilityService
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IReservationService ReservationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<ResourceDetails> Logger
<PageTitle>Resource Details</PageTitle>

@if (isLoading)
{
    <p>Loading resource...</p>
}
else if (resource is null)
{
    <div class="alert alert-danger">
        The requested resource could not be found.
    </div>

    <a class="btn btn-secondary" href="/resources">
        Return to resources
    </a>
}
else
{
    <div class="row g-4">
        <section class="col-lg-7">
            <a href="/resources">← Back to resources</a>

            <h1 class="mt-3">@resource.Name</h1>
            <p>@resource.Description</p>

            <dl>
                <dt>Location</dt>
                <dd>@resource.Location.Name</dd>

                <dt>Capacity</dt>
                <dd>@resource.Capacity</dd>

                <dt>Resource type</dt>
                <dd>@resource.Type</dd>

                <dt>Approval</dt>
                <dd>
                    @(resource.ApprovalMode == Data.Enums.ApprovalMode.Instant
                        ? "Instant confirmation"
                        : "Manager approval required")
                </dd>
            </dl>

            <h2 class="h5">Amenities</h2>

            @if (resource.Amenities.Count == 0)
            {
                <p>No amenities are listed.</p>
            }
            else
            {
                <ul>
                    @foreach (var amenity in resource.Amenities)
                    {
                        <li>@amenity.Name</li>
                    }
                </ul>
            }
        </section>
        <div class="resource-tabs" role="tablist" aria-label="Resource information">
            @foreach (var tab in Enum.GetValues<DetailsTab>())
            {
                <button type="button" role="tab" class="resource-tab @(selectedTab == tab ? "active" : "")"
                        aria-selected="@(selectedTab == tab)" @onclick="() => SelectTabAsync(tab)">
                    @tab
                </button>
            }
        </div>
        <div class="resource-tab-content">
            @switch (selectedTab)
            {
                case DetailsTab.Overview:
                    <section role="tabpanel">
                        <p>@resource.Description</p>

                        <h2 class="h5">Amenities</h2>

                        @if (resource.Amenities.Count == 0)
                        {
                            <p>No amenities are listed.</p>
                        }
                        else
                        {
                            <div class="amenity-grid">
                                @foreach (var amenity in resource.Amenities
                                    .OrderBy(amenity => amenity.Name))
                                {
                                    <div class="amenity-item">
                                        @amenity.Name
                                    </div>
                                }
                            </div>
                        }

                        <div class="resource-stat-grid">
                            <div>
                                <strong>@resource.Capacity</strong>
                                <span>Maximum capacity</span>
                            </div>

                            <div>
                                <strong>@resource.Amenities.Count</strong>
                                <span>Amenities</span>
                            </div>
                        </div>
                    </section>
                    break;

                case DetailsTab.Availability:
                    <section role="tabpanel">
                        <div class="calendar-header">
                            <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Previous month"
                                    @onclick="ShowPreviousMonthAsync">
                                ←
                            </button>

                            <strong>
                                @displayedMonth.ToString("MMMM yyyy")
                            </strong>

                            <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Next month"
                                    @onclick="ShowNextMonthAsync">
                                →
                            </button>
                        </div>

                        @if (isLoadingAvailability)
                        {
                            <p>Loading availability...</p>
                        }
                        else
                        {
                            <div class="calendar-grid">
                                @foreach (var dayName in
                                    new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                                {
                                    <strong class="calendar-weekday">
                                        @dayName
                                    </strong>
                                }

                                @for (var blank = 0;
                                    blank < (int)displayedMonth.DayOfWeek;
                                    blank++)
                                {
                                    <span></span>
                                }

                                @foreach (var day in monthlyAvailability)
                                {
                                    <div class="calendar-day @GetStatusClass(day.Status)" title="@day.Status">
                                        <span>@day.Date.Day</span>
                                    </div>
                                }
                            </div>

                            <div class="calendar-legend">
                                <span><i class="available"></i> Available</span>
                                <span><i class="partial"></i> Partial</span>
                                <span><i class="booked"></i> Booked</span>
                                <span><i class="closed"></i> Closed</span>
                            </div>
                        }
                    </section>
                    break;

                case DetailsTab.Policies:
                    <section role="tabpanel">
                        @if (resource.PolicyNotices.Count == 0)
                        {
                            <p>No policy notices are currently listed.</p>
                        }
                        else
                        {
                            <ul class="policy-list">
                                @foreach (var notice in resource.PolicyNotices
                                    .Where(notice => notice.IsActive)
                                    .OrderBy(notice => notice.DisplayOrder))
                                {
                                    <li>@notice.Message</li>
                                }
                            </ul>
                        }
                    </section>
                    break;

                case DetailsTab.Reviews:
                    <section role="tabpanel">
                        @if (resource.Reviews.Count == 0)
                        {
                            <p>No reviews have been submitted yet.</p>
                        }
                        else
                        {
                            <div class="review-list">
                                @foreach (var review in resource.Reviews
                                    .OrderByDescending(review => review.CreatedAt))
                                {
                                    <article class="review-card">
                                        <div>
                                            <strong>
                                                @(review.User.UserName ?? "ReserveFlow user")
                                            </strong>

                                            <span>
                                                @review.CreatedAt.ToString("MMM yyyy")
                                            </span>
                                        </div>

                                        <div class="review-stars" aria-label="@($"{review.Rating} out of 5 stars")">
                                            @GetStars(review.Rating)
                                        </div>

                                        <p>@review.Comment</p>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                    break;
            }
        </div>
        <section class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h2 class="h4">Reserve this resource</h2>

                    @if (!string.IsNullOrWhiteSpace(resultMessage))
                    {
                        <div class="alert @resultCssClass" role="alert">
                            @resultMessage
                        </div>
                    }

                    <EditForm Model="bookingForm" OnValidSubmit="SubmitReservationAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label" for="booking-purpose">
                                Reservation purpose
                            </label>

                            <InputTextArea id="booking-purpose" class="form-control"
                                           placeholder="Describe what this resource will be used for"
                                           @bind-Value="bookingForm.Purpose" />

                            <ValidationMessage For="@(() => bookingForm.Purpose)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="start-time">
                                Start date and time
                            </label>

                            <InputDate id="start-time" class="form-control" Type="InputDateType.DateTimeLocal"
                                       @bind-Value="bookingForm.StartTime" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="end-time">
                                End date and time
                            </label>

                            <InputDate id="end-time" class="form-control" Type="InputDateType.DateTimeLocal"
                                       @bind-Value="bookingForm.EndTime" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="attendee-count">
                                Number of attendees
                            </label>

                            <InputNumber id="attendee-count" class="form-control" @bind-Value="bookingForm.AttendeeCount" />

                            <ValidationMessage For="@(() => bookingForm.AttendeeCount)" />
                        </div>

                        <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
                            @(isSubmitting
                                ? "Submitting..."
                                : "Submit reservation")
                        </button>
                    </EditForm>
                </div>
            </div>
        </section>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Resource? resource;
    private string? userId;
    private bool isLoading = true;
    private bool isSubmitting;
    private string? resultMessage;
    private string resultCssClass = "alert-danger";

    private readonly BookingFormModel bookingForm = new();
    private DetailsTab selectedTab = DetailsTab.Overview;

    private DateOnly displayedMonth;

    private IReadOnlyList<DailyAvailability> monthlyAvailability = [];

    private bool isLoadingAvailability;

    private enum DetailsTab
    {
        Overview,
        Availability,
        Policies,
        Reviews
    }
    /// <summary>
    /// Loads the selected resource and obtains the signed-in user's ID.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await using var dbContext =
            await DbContextFactory.CreateDbContextAsync();

        resource = await dbContext.Resources
    .AsNoTracking()
    .AsSplitQuery()
    .Include(resource => resource.Location)
    .Include(resource => resource.Amenities)
    .Include(resource => resource.PolicyNotices)
    .Include(resource => resource.Reviews)
        .ThenInclude(review => review.User)
    .SingleOrDefaultAsync(resource => resource.Id == Id);

        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId = authenticationState.User.FindFirstValue(
            ClaimTypes.NameIdentifier);

        isLoading = false;
        if (resource is not null)
        {
            // Determines the current month at the resource's location.
            var timeZone = TimeZoneInfo.FindSystemTimeZoneById(
                resource.Location.TimeZoneId);

            var localNow = TimeZoneInfo.ConvertTime(
                DateTimeOffset.UtcNow,
                timeZone);

            displayedMonth = new DateOnly(
                localNow.Year,
                localNow.Month,
                1);
        }
    }

    /// <summary>
    /// Sends the validated form to the reservation service and displays
    /// the result returned by the business logic.
    /// </summary>
    /// <summary>
    /// Converts the selected times to UTC, submits the reservation,
    /// and handles database errors without crashing the Blazor circuit.
    /// </summary>
    private async Task SubmitReservationAsync()
    {
        if (resource is null || string.IsNullOrWhiteSpace(userId))
        {
            resultMessage = "You must be signed in to create a reservation.";
            resultCssClass = "alert-danger";
            return;
        }

        isSubmitting = true;
        resultMessage = null;

        try
        {
            var request = new CreateReservationRequest(
                resource.Id,
                bookingForm.Purpose,

                // PostgreSQL stores these reservation timestamps in UTC.
                bookingForm.StartTime.ToUniversalTime(),
                bookingForm.EndTime.ToUniversalTime(),

                bookingForm.AttendeeCount);

            var result = await ReservationService.CreateAsync(request, userId);

            resultMessage = result.Message;
            resultCssClass = result.Succeeded
                ? "alert-success"
                : "alert-danger";
        }
        catch (Exception exception)
        {
            // Record the technical error in the terminal while showing the
            // user a safe, understandable message.
            Logger.LogError(
                exception,
                "An error occurred while creating a reservation.");

            resultMessage =
                "We could not complete your reservation. Please try again.";

            resultCssClass = "alert-danger";
        }
        finally
        {
            // Ensures the button becomes available even when an error occurs.
            isSubmitting = false;
        }
    }
    private sealed class BookingFormModel
    {
        [Required(ErrorMessage = "Please provide a reservation purpose.")]
        [StringLength(500, MinimumLength = 5)]
        public string Purpose { get; set; } = string.Empty;

        [Required]
        public DateTimeOffset StartTime { get; set; }
            = DateTimeOffset.Now.AddDays(1).Date.AddHours(9);

        [Required]
        public DateTimeOffset EndTime { get; set; }
            = DateTimeOffset.Now.AddDays(1).Date.AddHours(10);

        [Range(1, 1000)]
        public int AttendeeCount { get; set; } = 1;
    }
    /// <summary>
    /// Changes the visible tab and loads calendar data only when the
    /// Availability tab is requested.
    /// </summary>
    private async Task SelectTabAsync(DetailsTab tab)
    {
        selectedTab = tab;

        if (tab == DetailsTab.Availability &&
            monthlyAvailability.Count == 0)
        {
            await LoadAvailabilityAsync();
        }
    }

    /// <summary>
    /// Loads availability for the currently displayed calendar month.
    /// </summary>
    private async Task LoadAvailabilityAsync()
    {
        if (resource is null)
        {
            return;
        }

        isLoadingAvailability = true;

        try
        {
            monthlyAvailability =
                await AvailabilityService.GetMonthAsync(
                    resource.Id,
                    displayedMonth.Year,
                    displayedMonth.Month);
        }
        finally
        {
            isLoadingAvailability = false;
        }
    }

    private async Task ShowPreviousMonthAsync()
    {
        displayedMonth = displayedMonth.AddMonths(-1);
        await LoadAvailabilityAsync();
    }

    private async Task ShowNextMonthAsync()
    {
        displayedMonth = displayedMonth.AddMonths(1);
        await LoadAvailabilityAsync();
    }

    private static string GetStatusClass(
        DailyAvailabilityStatus status) =>
        status.ToString().ToLowerInvariant();

    private static string GetStars(int rating) =>
        $"{new string('★', rating)}{new string('☆', 5 - rating)}";
}